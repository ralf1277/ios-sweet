diff -ru a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
--- a/osfmk/arm64/machine_routines.c	2026-11-08 20:10:56.837237786 +0200
+++ b/osfmk/arm64/machine_routines.c	2026-11-08 20:10:56.849945617 +0200
@@ -2273,8 +2273,16 @@
 	uint64_t cntvctl = CNTV_CTL_EL0_ENABLE; /* One wants to use 32 bits, but "mrs" prefers it this way */
 
 	__builtin_arm_wsr64("CNTV_CTL_EL0", cntvctl);
+#if !defined(SWEET)
 	/* disable the physical timer as a precaution, as its registers reset to architecturally unknown values */
 	__builtin_arm_wsr64("CNTP_CTL_EL0", CNTP_CTL_EL0_IMASKED);
+#endif
+	/*
+	 * SWEET (renoir): Qualcomm's hypervisor traps EL1 access to the physical
+	 * timer (CNTHCTL_EL2.EL1PCEN = 0), so the write above is an undefined
+	 * instruction there. Linux on these SoCs only uses the virtual timer
+	 * too; the physical timer stays the hypervisor's business.
+	 */
 }
 
 void
